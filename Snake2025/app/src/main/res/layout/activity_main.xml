<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <com.example.snake2025.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="#33000000">

        <TextView
            android:id="@+id/tvUser"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Not logged in"
            android:textColor="#FFF"/>

        <ImageButton
            android:id="@+id/btnLeaderboard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="@null"/>

        <ImageButton
            android:id="@+id/btnLogin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_manage"
            android:background="@null"/>
    </LinearLayout>

    <!-- Directional buttons bottom right -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_gravity="bottom|end"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/arrow_up_float"
            android:background="#66000000"/>

        <LinearLayout android:orientation="horizontal">
            <ImageButton
                android:id="@+id/btnLeft"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/arrow_left_float"
                android:background="#66000000"/>

            <View android:layout_width="16dp"
                android:layout_height="64dp"/>

            <ImageButton
                android:id="@+id/btnRight"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/arrow_right_float"
                android:background="#66000000"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDown"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/arrow_down_float"
            android:background="#66000000"/>
    </LinearLayout>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading joke..."
            android:textSize="18sp"
            android:gravity="center"/>
    </LinearLayout>

</FrameLayout>
